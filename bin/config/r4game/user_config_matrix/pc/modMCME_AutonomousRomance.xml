<?xml version="1.0" encoding="utf-8"?>
<UserConfig>
    <Group id="MCM_AR" displayName="Mods.AutonomousRomance">

        <PresetsArray>
            <Preset id="0" displayName="mcm_ar_preset_default">
                <Entry varId="MCM_AR_Enabled"         value="1"/>
                <Entry varId="MCM_AR_CooldownSlider"  value="720"/>
                <Entry varId="MCM_AR_AffinityMult"    value="10"/>
                <Entry varId="MCM_AR_JealousyMode"    value="1"/>
                <Entry varId="MCM_AR_ForceRomance"    value="0"/>
                <Entry varId="MCM_AR_RequireConsent"  value="1"/>
                <Entry varId="MCM_AR_DebugHud"        value="1"/>
            </Preset>

            <Preset id="1" displayName="mcm_ar_preset_active">
                <Entry varId="MCM_AR_Enabled"         value="1"/>
                <Entry varId="MCM_AR_CooldownSlider"  value="300"/>
                <Entry varId="MCM_AR_AffinityMult"    value="20"/>
                <Entry varId="MCM_AR_JealousyMode"    value="1"/>
                <Entry varId="MCM_AR_ForceRomance"    value="0"/>
                <Entry varId="MCM_AR_RequireConsent"  value="1"/>
                <Entry varId="MCM_AR_DebugHud"        value="1"/>
            </Preset>

            <Preset id="2" displayName="mcm_ar_preset_relaxed">
                <Entry varId="MCM_AR_Enabled"         value="1"/>
                <Entry varId="MCM_AR_CooldownSlider"  value="1200"/>
                <Entry varId="MCM_AR_AffinityMult"    value="5"/>
                <Entry varId="MCM_AR_JealousyMode"    value="1"/>
                <Entry varId="MCM_AR_ForceRomance"    value="0"/>
                <Entry varId="MCM_AR_RequireConsent"  value="1"/>
                <Entry varId="MCM_AR_DebugHud"        value="0"/>
            </Preset>

            <Preset id="3" displayName="mcm_ar_preset_sandbox">
                <Entry varId="MCM_AR_Enabled"         value="1"/>
                <Entry varId="MCM_AR_CooldownSlider"  value="60"/>
                <Entry varId="MCM_AR_AffinityMult"    value="50"/>
                <Entry varId="MCM_AR_JealousyMode"    value="0"/>
                <Entry varId="MCM_AR_ForceRomance"    value="1"/>
                <Entry varId="MCM_AR_RequireConsent"  value="0"/>
                <Entry varId="MCM_AR_DebugHud"        value="1"/>
            </Preset>

            <Preset id="4" displayName="mcm_ar_preset_disabled">
                <Entry varId="MCM_AR_Enabled"         value="0"/>
            </Preset>
        </PresetsArray>

        <VisibleVars>
            <Var id="MCM_AR_Enabled"
                 displayName="mcm_ar_opt_enabled"
                 displayType="TOGGLE"
                 defaultValue="1"/>

            <Var id="MCM_AR_CooldownSlider"
                 displayName="mcm_ar_opt_cooldown"
                 displayType="SLIDER;60;1200;19"
                 defaultValue="720"/>

            <Var id="MCM_AR_AffinityMult"
                 displayName="mcm_ar_opt_affinity"
                 displayType="SLIDER;5;50;9"
                 defaultValue="10"/>

            <Var id="MCM_AR_JealousyMode"
                 displayName="mcm_ar_opt_jealousy"
                 displayType="TOGGLE"
                 defaultValue="1"/>

            <Var id="MCM_AR_ForceRomance"
                 displayName="mcm_ar_opt_force"
                 displayType="TOGGLE"
                 defaultValue="0"/>

            <Var id="MCM_AR_RequireConsent"
                 displayName="mcm_ar_opt_consent"
                 displayType="TOGGLE"
                 defaultValue="1"/>

            <Var id="MCM_AR_DebugHud"
                 displayName="mcm_ar_opt_debug"
                 displayType="TOGGLE"
                 defaultValue="1"/>
        </VisibleVars>
